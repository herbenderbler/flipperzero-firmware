    { 0xf1, 0xd0, 0xff, 0xf1, 0xde, 0xaa, 0xec, 0xee, 0xb4, 0x2f, 0xc9, 0xba, 0x7e, 0xd6, 0x23, 0xbb }
#define BLE_U2F_STATUS_UUID \
    { 0xf1, 0xd0, 0xff, 0xf2, 0xde, 0xaa, 0xec, 0xee, 0xb4, 0x2f, 0xc9, 0xba, 0x7e, 0xd6, 0x23, 0xbb }
#define BLE_U2F_CONTROL_POINT_LENGTH_UUID \
    { 0xf1, 0xd0, 0xff, 0xf3, 0xde, 0xaa, 0xec, 0xee, 0xb4, 0x2f, 0xc9, 0xba, 0x7e, 0xd6, 0x23, 0xbb }
#define BLE_U2F_SERVICE_REVISION_BITFIELD_UUID \
    { 0xf1, 0xd0, 0xff, 0xf4, 0xde, 0xaa, 0xec, 0xee, 0xb4, 0x2f, 0xc9, 0xba, 0x7e, 0xd6, 0x23, 0xbb }

